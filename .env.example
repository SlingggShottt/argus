# Copy this file to .env and fill in real values. Never commit .env itself.

# Database
DATABASE_URL=postgresql://argus:argus@localhost:5432/argus

# LLM (Groq — free tier, see docs/techstack.md)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Forecast / risk tunables
FORECAST_HORIZON_DAYS=30
STOCKOUT_RISK_THRESHOLD=0.9
ANOMALY_ZSCORE_THRESHOLD=2.5

# Inventory synthesis (dataset has no real inventory data, see context.md)
LEAD_TIME_DAYS=7
INVENTORY_LOOKBACK_DAYS=90
INVENTORY_DAYS_OF_COVER_MIN=3
INVENTORY_DAYS_OF_COVER_MAX=21
INVENTORY_RANDOM_SEED=42
